# 生产环境直连知乎开放平台时使用。不要提交真实密钥。
ZHIHU_ACCESS_SECRET=

# 本地开发默认调用已认证的官方 CLI；需要覆盖时指定绝对路径。
ZHIHU_CLI_PATH=

ZHIHU_APP_ID=
ZHIHU_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://zhixing-nine.vercel.app/api/auth/zhihu/callback
ZHIHU_OAUTH_SESSION_SECRET =

# PostgreSQL 连接地址。未配置时 API 仍可提供知乎搜索与答卷生成。
DATABASE_URL=
PORT=
